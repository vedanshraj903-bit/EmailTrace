# EmailTrace frontend configuration. Copy to frontend/.env.local and adjust.

# API base path used by the browser. Keep /api to go through the Vite dev proxy,
# or set a full URL (e.g. https://api.example.org/api) when the API is hosted elsewhere.
VITE_API_BASE=/api

# The dev proxy target is read from the shell, not from this file:
#   VITE_API_TARGET=http://127.0.0.1:8000 npm run dev
