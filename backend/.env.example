# EmailTrace backend configuration. Copy to backend/.env and adjust.
# Every value is optional; the defaults below match app/config.py.

# ---- External intelligence ----
# IPinfo token for IP geolocation/ASN when no MaxMind database is present (https://ipinfo.io/signup).
IPINFO_TOKEN=
# MaxMind GeoLite2 (free account at https://www.maxmind.com → Manage License Keys → Generate).
# With both set, the City and ASN databases download on startup and refresh weekly;
# or run `python -m app.services.geoip_update` from backend/.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
# Database files. By default they are read from backend/data/geoip/.
# By default they are read from backend/data/geoip/; set absolute paths only to use another location.
# MAXMIND_CITY_DB=/absolute/path/GeoLite2-City.mmdb
# MAXMIND_ASN_DB=/absolute/path/GeoLite2-ASN.mmdb

# ---- Storage ----
# Defaults live under backend/data and backend/ml. Relative paths resolve against the
# directory the server is started from, so use absolute paths when overriding.
# DATABASE_PATH=/absolute/path/emailtrace.db
# EVIDENCE_DIR=/absolute/path/evidence
# MODEL_PATH=/absolute/path/model.joblib

# ---- Network behaviour ----
DNS_TIMEOUT_S=3.0
HTTP_TIMEOUT_S=4.0
ENABLE_WHOIS=true
# Outbound port 25 is blocked on most networks; enable only where it is allowed.
ENABLE_SMTP_PROBE=false
SMTP_TIMEOUT_S=5.0
DEFAULT_ACCURACY_RADIUS_KM=25

# ---- Privacy / compliance ----
MASK_PII=false
RETENTION_DAYS=180
MAX_UPLOAD_BYTES=15728640

# ---- Cache lifetimes (hours) ----
WHOIS_CACHE_TTL_H=168
IP_CACHE_TTL_H=24
FEED_REFRESH_H=12

# ---- CORS (JSON list) ----
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
